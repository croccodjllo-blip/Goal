# GOAL API Bearer token — never commit the real key
GOAL_API_KEY=

# football-data.org (coach identity) — X-Auth-Token; never commit the real key
# Either name works:
FOOTBALL_DATA_API_KEY=
# FOOTBALL_DATA_TOKEN=

# API-Sports / API-Football v3 — shot-stat enrichment (optional)
# Header: x-apisports-key. Either name works:
API_SPORTS_KEY=
# APISPORTS_KEY=

# odss-api.com — odds comparison (optional; app runs without it)
# Header: x-api-key. Without this key the Quote section uses mock data.
# Live HTTP is NOT wired yet — setting the key alone does not call odss.
ODSS_API_KEY=
# ODSS_API_BASE_URL=https://odss-api.com/api/v1
# ODDS_CACHE_DIR=.cache/odds

# Optional web bind
# GOAL_XG_HOST=127.0.0.1
# GOAL_XG_PORT=8000

# Optional overrides
# GOAL_API_BASE_URL=https://api.goal-api.com/v1
# GOAL_API_WS_URL=wss://api.goal-api.com/ws
# GOAL_API_CACHE_DIR=.cache/goal_api
# FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
# FOOTBALL_DATA_MIN_INTERVAL_S=6.5
# API_SPORTS_BASE_URL=https://v3.football.api-sports.io
# API_SPORTS_MIN_INTERVAL_S=0.35
